{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melly IDE",
  "version": "0.7.0-alpha.3",
  "identifier": "com.melly.ide",
  "build": {
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Melly IDE",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "release-notices/": "licenses/"
    }
  }
}
